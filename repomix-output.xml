<file path="src/style.css">
/* ----- Color Palette ----- */
:root {
  --bg-darkest: #0F1115;
  --bg-dark: #191C22;
  --bg-mid: #20242C;
  --accent-bronze: #A8875C;
  --accent-maroon: #6B2E2E;
  --text-primary: #F2EFE9;
  --text-muted: #A9A49C;
  --border-color: #2B2F38;
}

/* ----- Animation ----- */

@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(30px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInDown {
  0% {
    opacity: 0;
    transform: translateY(-20px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInRight {
  0% {
    opacity: 0;
    transform: translateX(-20px);
  }

  100% {
    opacity: 1;
    transform: translateX(0px);
  }
}

@view-transition {
  navigation: auto;
}

/* ----- Structure Elements ----- */

html,
body {
  height: 100%;
  scroll-behavior: smooth;
  background-color: var(--bg-darkest);
}

body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* ----- Scroll ----- */

/* Firefox */

* {
  scrollbar-width: 5px;
  scrollbar-color: #2B2F38 #0F1115;
}

/* Chrome, Edge, Safari */

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #0F1115;
}

::-webkit-scrollbar-thumb {
  background: #2B2F38;
  border-radius: 6px;
  border: 2px solid #0F1115;
}

::-webkit-scrollbar-thumb:hover {
  background: #A8875C;
}

/* ----- Header ----- */

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  background-color: var(--bg-dark);
  padding: 2px 15px;
  border-bottom: 1px solid var(--border-color);
  z-index: 1;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Georgia', serif;
  font-size: 1.4rem;
  color: var(--text-primary);
}

.logo-icon {
  width: 40px;
  height: 40px;
  padding: 5px;
}

.nav-links {
  display: flex;
  gap: 40px;
  margin-right: auto;
  margin-left: 1%;
}

.nav-links a {
  color: var(--text-primary);
  text-decoration: none;
  font-size: 1.2rem;
  transition: color 0.2s ease;
}

.nav-links a:hover {
  color: var(--accent-bronze);
}

.account {
  display: flex;
  align-items: center;
}

.account a {
  display: flex;
  align-items: center;
  gap: 8px;
}

.account .account-icon {
  width: 30px;
  height: 30px;
  filter: invert(100%);
}

.account-avatar-default {
  filter: brightness(0) saturate(100%) invert(56%) sepia(35%) saturate(542%) hue-rotate(345deg) brightness(94%) contrast(89%);
}

/* ----- For all Sections ----- */

body {
  background-color: var(--bg-darkest);
  color: var(--text-primary);
  overflow: hidden;
}

main {
  min-height: 100vh;
  margin: 0;
  background-color: rgba(0, 0, 0, 0.75);
  overflow-y: auto;
}

main .section-header {
  display: flex;
  margin-left: 20px;
  margin-top: 0;
  font-size: 1rem;
  color: var(--text-primary);
  animation: fadeInDown .5s ease-out forwards;
}

.box {
  border: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  width: fit-content;
  background-color: rgba(32, 36, 44, 0.7);
  padding-top: 10px;
  padding-bottom: 10px;
}

.empha {
  color: var(--accent-bronze);
}

.goTop {
  text-decoration: none;
  color: var(--accent-bronze);
  font-size: 1.1rem;
  cursor: pointer;
}

.goTop:hover {
  color: var(--accent-maroon);
}

/* ----- Account ----- */

#googleSignInBtn {
  all: unset;
  width: 390;
  margin-top: 2%;
}

.account-toggle {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  line-height: 0;
}

.account-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid #2B2F38;
}

.user-menu {
  position: relative;
}

.account-dropdown {
  display: none;
  position: absolute;
  top: calc(100% + 0.5rem);
  right: 0;
  background: var(--bg-dark);
  border: 1px solid var(--border-color);
  padding: 0.75rem 1rem;
  min-width: 160px;
  z-index: 10;
}

.account-dropdown.open {
  display: block;
}

.account-name {
  color: var(--text-primary);
  font-size: 0.9rem;
  margin: 0 0 0.5rem;
}

.account-dropdown hr {
  height: 1px;
  border: none;
  background-color: var(--border-color);
}

.account-dropdown #signout-btn {
  background: none;
  border: none;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 1rem;
  cursor: pointer;
  text-decoration: none;
  padding: 0;
}

.account-dropdown #signout-btn:hover {
  color: var(--accent-bronze);
}

/* ----- Footer ----- */

footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 35vh;
  width: 100%;
  background-color: var(--bg-mid);
}

footer hr {
  margin: 1.5%;
  width: 75%;
}

footer nav {
  display: flex;
  flex-direction: column;
  margin: 0;
  justify-content: center;
}

footer .top {
  display: flex;
  flex-direction: row;
  margin-top: 1%;
}

footer table {
  table-layout: fixed;
  border-collapse: collapse;
}

footer table th,
footer table td {
  /* border: 1px solid var(--border-color); */
  /* Uncomment to show border */
  min-width: 280px;
  padding: 6px;
  padding-left: 10%;
}

footer table th {
  text-align: left;
}

footer table .address {
  margin-bottom: auto;
}

footer .bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
}

footer .bottom h5 {
  margin: 10px;
}

/* ----- Separator -----*/
/*
Source - https://stackoverflow.com/a/26634224
Posted by MatTheCat, modified by community. See post 'Timeline' for change history
Retrieved 2026-08-20, License - CC BY-SA 4.0
*/

.separator {
  display: flex;
  align-items: center;
  text-align: center;
  width: 50%;
  margin-top: 2%;
  color: var(--text-muted);
}

.separator::before,
.separator::after {
  content: '';
  flex: 1;
  border-bottom: 1px solid var(--text-muted);
}

.separator:not(:empty)::before {
  margin-right: .25em;
}

.separator:not(:empty)::after {
  margin-left: .25em;
}
</file>

