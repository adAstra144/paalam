<file path="src/index.css">
.root {
  background-image: url('assets/bg1.png');
  background-repeat: no-repeat;
  background-size: cover;
}

.root main {
  height: 100vh;
  flex: 1;
  overflow-y: scroll;
}

.root main .top-section {
  display: flex;
  justify-content: center;
}

.root main .tagline {
  display: flex;
  justify-content: center;
  margin-top: 10%;
  color: var(--accent-bronze);
  font-weight: 10;
  animation: fadeInDown .6s ease-out forwards;
}

.root main .description {
  text-align: left;
  max-width: 80%;
  color: var(--text-primary);
  font-size: 1.2rem;
  animation: fadeInDown .4s ease-out forwards;
}

.root main hr {
  width: 85%;
  margin-top: 3%;
}

.root main .enter-site {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.root main .enter-site-text {
  display: flex;
  justify-content: center;
  color: var(--accent-bronze);
  animation: fadeInDown .2s ease-out forwards;
}

.root main .enter-site-btn a {
  display: flex;
  margin: 0 auto;
  width: fit-content;
  padding: 5px 20px;
  text-decoration: none;
  font-size: 1.9rem;
  color: var(--bg-darkest);
  background-color: var(--text-primary);
  border-radius: 30px;
  animation: fadeInDown .2s ease-out forwards;
  transition: background-color 0.2s ease;
}

.root main .enter-site-btn a:hover {
  background-color: var(--accent-maroon);
  color: var(--text-primary);
}

.root main footer {
  margin-top: 21%;
}
</file>

<file path="src/signup.css">
.signup {
  background-image: url(assets/bg5.png);
  background-size: cover;
  background-repeat: no-repeat;
  animation: fadeInRight .4s ease-out forwards;
}

.signup main {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.signup main .info-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  width: 50%;
}

.signup main .info-section .return {
  width: fit-content;
  text-decoration: none;
  margin-right: auto;
  margin-top: 15px;
  margin-left: 20px;
}

.signup main .info-section .return a {
  color: var(--text-primary);
  text-decoration: none;
  width: fit-content;
  display: inline-flex;
  align-items: center;
}

.signup main .info-section .return img {
  height: 35px;
  width: 35px;
  filter: invert(100%);
}

.signup main .info-section .return:hover :is(img, a) {
    color: var(--accent-bronze);
    filter: brightness(0) saturate(100%) invert(56%) sepia(35%) saturate(542%) hue-rotate(345deg) brightness(94%) contrast(89%);
}

.signup main .info-section header h1 {
  text-align: center;
  margin-top: 7%;
  margin-bottom: 15px;
  color: var(--accent-bronze);
}

.signup main .info-section header h4 {
  text-align: center;
  margin-top: 0;
  margin-bottom: 30px;
}

.signup main .info-section details {
  width: 80%;
}

.signup main .info-section details summary {
  text-align: center;
}

.signup main .info-section details summary:hover {
  color: var(--accent-bronze);
}

.signup main .info-section details li {
  list-style-type: "✓  ";
  font-size: 1.1rem;
  margin-top: 35px;
}

.signup main .info-section details li p {
  margin: 0;
  margin-top: 5px;
}

.signup main .signup-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  width: 50%;
  background-color: var(--bg-dark);
}

.signup main .signup-section .signin {
  align-self: flex-start;
  margin-left: 20px;
  color: var(--text-primary);
}

.signup main .signup-section .top {
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.signup main .signup-section .signin a {
  text-decoration: underline;
  color: var(--accent-bronze);
}

/* .signup main .signup-section .skip {
    margin-right: 2%;
}

.signup main .signup-section .skip a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--text-primary);
}

.signup main .signup-section .skip img {
    height: 40px;
    width: 40px;
    filter: invert(100%);
}

.signup main .signup-section .skip img:hover {
    filter: brightness(0) saturate(100%) invert(56%) sepia(35%) saturate(542%) hue-rotate(345deg) brightness(94%) contrast(89%);
} */

.signup main .signup-section h1 {
  margin-bottom: 5%;
}

.signup main .signup-section form {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 50%;
  margin-top: 2%;
  justify-content: center;
}

.signup main .signup-section form div {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  margin-bottom: 5%;
}

.signup main .signup-section form label {
  font-size: 1.1rem;
  margin-bottom: 8px;
}

.signup main .signup-section form input {
  width: 100%;
  background-color: var(--bg-mid);
  border: 2px solid var(--border-color);
  border-radius: 5px;
  color: var(--text-primary);
  height: 30px;
}

.signup main .signup-section form .terms {
  display: flex;
  flex-direction: row;
  margin-top: 4%;
}

.signup main .signup-section form .terms label {
  margin: auto 0;
  margin-left: 2%;
  font-size: 1.1rem;
}

.signup main .signup-section form .terms input {
  scale: 100%;
  width: 20px;
}

.signup main .signup-section form .submit input {
  background-color: var(--accent-bronze);
  color: var(--bg-darkest);
  height: 45px;
  font-size: 1.2rem;
}

.signup main .signup-section h5 {
  margin-top: auto;
  margin-bottom: 5%;
  color: var(--text-muted);
}

.signup main .signup-section h5 a {
  text-decoration: underline;
  color: var(--text-muted);
}
</file>

<file path="src/store.css">
.store {
  background: url('assets/bg3.png');
  background-size: cover;
  background-repeat: no-repeat;
}

.store header .nav-links a:nth-of-type(2) {
  color: var(--accent-bronze) !important;
}

.store main {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  overflow-y: auto;
}

.store main .tagline {
  display: flex;
  justify-content: center;
  margin-top: 20px;
  margin-bottom: 20px;
  font-weight: 10;
  color: var(--accent-bronze);
  animation: fadeInDown .6s ease-out forwards;
}

.store main .product-grid1 {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: center;
  background-color: rgba(25, 28, 34, 0.85);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 32px;
  margin-top: 2%;
  max-width: 1000px;
  animation: fadeInDown .4s ease-out forwards;
}

.store main .product-grid2 {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: center;
  background-color: rgba(25, 28, 34, 0.85);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 32px;
  margin-top: 5%;
  max-width: 1000px;
  animation: fadeInDown .2s ease-out forwards;
}

.store main .product-grid3 {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: center;
  background-color: rgba(25, 28, 34, 0.85);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 32px;
  margin-top: 5%;
  margin-bottom: 10%;
  max-width: 1000px;
  animation: fadeInDown .1s ease-out forwards;
}

.store main .product-card {
  background-color: var(--bg-mid);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 16px;
  width: 180px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.store main .product-card:hover {
  transform: translateY(-2px);
  border-color: var(--accent-bronze);
}

.store main .product-card img {
  width: 100%;
  min-height: 150px;
  border-radius: 4px;
  background-color: #fff;
  color: var(--bg-darkest);
}

.store main .product-card h3 {
  font-size: 13px;
  font-weight: normal;
  line-height: 1.4;
  color: var(--text-primary);
  margin-top: auto;
}

.store main .product-card .price {
  font-size: 13px;
  color: var(--accent-bronze);
}

.store main .product-card .usd {
  color: var(--text-muted);
}

.store main .inquire-btn {
  background-color: var(--text-primary);
  color: var(--bg-darkest);
  border: none;
  border-radius: 20px;
  padding: 8px 16px;
  font-size: 13px;
  cursor: pointer;
  align-self: flex-start;
}

.store main .inquire-btn:hover {
  background-color: var(--accent-bronze);
  color: var(--bg-darkest);
}

.store main footer {
  padding-bottom: 5%;
}
</file>

<file path="notes/color-scheme.md">
"Quiet Mourning v2"

Background: 
#0F1115 (deep charcoal-black)

Header/Surface: 
#191C22

Card/Elevated surface: 
#20242C

Primary accent (bronze/gold): 
#A8875C (warmed up slightly, less muddy than before)

Secondary accent (deep maroon): 
#6B2E2E (for tags, dividers, subtle highlights)

Text primary: 
#F2EFE9

Text secondary/muted: 
#A9A49C

Borders/dividers: 
#2B2F38

Hover/active state: 
#C4A57A (lighter bronze, for buttons/links on hover)
</file>

