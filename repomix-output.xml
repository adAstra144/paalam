<file path="src/contact.css">
.contact {
  background: url('assets/bg4.png');
  background-size: cover;
  background-repeat: no-repeat;
}

.contact header .nav-links a:nth-of-type(3) {
  color: var(--accent-bronze) !important;
}

.contact main {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contact main .tagline {
  margin-top: 20px;
  color: var(--accent-bronze);
  animation: fadeInDown .6s ease-out forwards;
}

.contact main .info {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80%;
}

.contact main .box {
  display: flex;
  flex-wrap: wrap;
  width: 90%;
  animation: fadeInDown .4s ease-out forwards;
}

.contact main .info-header {
  margin-left: 2%;
  color: var(--accent-bronze);
}

.contact main .socials {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  margin-left: 2%;
  padding: 10px;
}

.contact main .icons a {
  text-decoration: none;
  color: var(--text-primary);
  cursor: pointer;
}

.contact main .icons img {
  top: auto;
  width: 30px;
  height: 30px;
  filter: invert(100%);
}

.contact main .icons span {
  margin-left: 2%;
  font-size: 1.2rem;
  top: auto;
  color: var(--text-primary);
  cursor: pointer;
}

.contact main .icons a:hover :is(img, span) {
  color: var(--accent-bronze);
  filter: brightness(0) saturate(100%) invert(56%) sepia(35%) saturate(542%) hue-rotate(345deg) brightness(94%) contrast(89%);
}

.contact main .info table {
  table-layout: fixed;
  margin-left: 2%;
  border-collapse: collapse;
  width: 60%;
}

.contact main .info th {
  text-align: left;
  color: var(--accent-bronze);
}

.contact main .info td {
  padding: 10px;
}

.contact main .add-info {
  display: flex;
  flex-direction: column;
  width: 80%;
  margin-left: 2%;
}

.contact main .add-info h2 {
  color: var(--accent-bronze);
}

.contact main .add-info p {
  font-size: 1.1rem;
}

.contact main footer {
  margin-top: 28%;
  padding-bottom: 5%;
}
</file>

<file path="src/home.css">
.home {
  background-image: url('assets/bg2.png');
  background-size: cover;
  background-repeat: no-repeat;
}

.home header .nav-links a:first-of-type {
  color: var(--accent-bronze) !important;
}

.home main {
  height: 100vh;
}

.home main .tagline {
  display: flex;
  justify-content: center;
  margin-top: 1%;
  margin-bottom: 1%;
  font-weight: 10;
  color: var(--accent-bronze);
  animation: fadeInDown .6s ease-out forwards;
}

.home main .our-services .box {
  border-radius: 10px;
  padding-bottom: 2%;
  animation: fadeInDown .4s ease-out forwards;
}

.home main .our-services {
  display: flex;
  justify-content: center;
}

.home main .our-services h2 {
  display: flex;
  margin-left: 2%;
  color: var(--accent-bronze);
}

.home main .our-services h3 {
  margin-top: 5%;
}

.home main .our-services .first {
  margin-top: 0px;
}

.home main .our-services li {
  margin-left: 3%;
  color: var(--text-primary);
}

.home main .space {
  padding-bottom: 10%;
}

.home main footer {
  height: 40vh;
}
