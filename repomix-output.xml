<file path="src/about.css">
.about {
    background-image: url('assets/bg6.png');
    background-size: cover;
    background-repeat: no-repeat;
}

.about .header .nav-links a:nth-of-type(4) {
    color: var(--accent-bronze);
}

.about main {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.about main .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 45%;
    height: 65%;
    margin-top: 1%;
    background-color: rgba(25, 28, 34, 0.8);
    border: 1px solid var(--border-color);
    border-radius: 10px;
}

.about main h1 {
    color: var(--accent-bronze);
    margin-top: 3%;
}

.about main .profile .me {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 5%;
}

.about main .profile .me .pfp {
    width: 115px;
    height: 115px;
    border-radius: 100%;
    border: 3px solid var(--border-color);
    margin-bottom: 10%;
}

.about main .profile .me h2 {
    margin-top: 0;
    margin-bottom: 0;
}

.about main .profile .who {
    display: flex;
    margin: 0 auto;
    width: 80%;
}

.about main .profile .who p {
    font-size: 1.1rem;
    line-height: 1.5rem;
    text-align: justify;
}

.about main .profile .who a {
    text-decoration: none;
    color: var(--accent-bronze);
}

.about main .profile .who a:hover {
    color: var(--accent-maroon);
    text-decoration: underline;
}

.about main .profile .links {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 5%;
}

.about main .profile .links h3 {
    margin-bottom: 3%;
}

.about main .profile .links .github {
    display: flex;
}

.about main .profile .links .github a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: underline;
    color: var(--accent-bronze);
}
.about main .profile .links .github a:hover {
    color: var(--accent-maroon);
}
.about main .profile .links .github img {
    width: 25px;
    height: 25px;
}

.about main .profile .submit {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: auto;
    margin-bottom: 5%;
    text-align: center;
    line-height: 1.2rem;
}

.about main .made-with {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    width: 45%;
    height: 65%;
    margin-top: 1%;
    background-color: rgba(25, 28, 34, 0.8);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 20px;
} 

.about main .made-with .things {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 30%;
}

.about main .made-with .things h2 {
    color: var(--accent-bronze);
    margin: 0;
}

.about main .made-with .things ul {
    padding-left: 10%;
}

.about main .made-with .things li {
    line-height: 1.9rem;
    font-size: 1.1rem;
}

.about main footer {
  margin-top: 5%;
  padding-bottom: 5%;
}
