        container.classList.add('signed-in');

        const avatarClass = user.isDefaultIcon
            ? 'account-avatar account-avatar-default'
            : 'account-avatar';

        container.innerHTML = `
            <div class="user-menu">
                <button id="account-toggle" class="account-toggle">
                    <img src="${user.picture}" alt="${user.name}" class="${avatarClass}">
                </button>
                <div class="account-dropdown" id="account-dropdown">
                    <p class="account-name">${user.name}</p>
                    <button id="signout-btn">Sign out</button>
                </div>
            </div>
        `;

        document.getElementById('account-toggle').addEventListener('click', () => {
            document.getElementById('account-dropdown').classList.toggle('open');
        });

        document.getElementById('signout-btn').addEventListener('click', () => {
            localStorage.removeItem('paalam_user');
            window.location.href = '/home';
        });
    }
}

document.addEventListener('DOMContentLoaded', renderHeaderAuth);
